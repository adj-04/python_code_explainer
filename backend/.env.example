# Copy this file to .env and fill in your real key.
# NEVER commit the actual .env file to git.

USE_GROQ=true
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed origins for CORS, or "*" for any
ALLOWED_ORIGINS=*

# Max characters accepted per /explain request
MAX_CODE_LENGTH=8000

# Per-IP rate limit for /explain (flask-limiter syntax)
RATE_LIMIT=10 per hour

# Hard cap on TOTAL /explain calls per day across all users.
# Groq's free tier caps at roughly 1,000-14,400 requests/day depending
# on model - keep this comfortably under that.
MAX_REQUESTS_PER_DAY=50

PORT=5000
